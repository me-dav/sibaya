APP_NAME=siBAYA
APP_ENV=production
# Buat dengan: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://sibaya.my.id
APP_LOCALE=id

# Log ke stderr agar terbaca lewat `docker compose logs`
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database (DB_HOST otomatis "db" dari docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sibaya
DB_USERNAME=sibaya
# Hindari karakter $ # " ' di password karena bisa rusak di docker compose
DB_PASSWORD=sibaya2026

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Isi jika fitur lupa password / verifikasi email dipakai
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@sibaya.contoh.id"
# MAIL_FROM_NAME="${APP_NAME}"

# Akun admin pertama (dipakai UserSeeder). Ganti dan jangan di-commit.
ADMIN_NAME="Admin siBAYA"
ADMIN_EMAIL=admin@sibaya.my.id
ADMIN_PASSWORD=password123

# docker compose
RUN_MIGRATIONS=true
WEB_BIND=127.0.0.1
WEB_PORT=8080
